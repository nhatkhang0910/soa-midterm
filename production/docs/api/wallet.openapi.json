            "title": "Userid"
          },
          "amount": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "state": {
            "type": "string",
            "enum": [
              "RESERVED",
              "CAPTURED",
              "CANCELLED"
            ],
            "title": "State"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "userId",
          "amount",
          "state"
        ],
        "title": "ReservationCommand"
      },
      "ReservationResponse": {
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "title": "Userid"
          },
          "amount": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "state": {
            "type": "string",
            "enum": [
              "RESERVED",
              "CAPTURED",
              "CANCELLED"
            ],
            "title": "State"
          },
          "paymentId": {
            "type": "string",
            "format": "uuid",
            "title": "Paymentid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "userId",
          "amount",
          "state",
          "paymentId"
        ],
        "title": "ReservationResponse"
      },
      "WalletResponse": {
        "properties": {
          "balance": {
            "type": "integer",
            "title": "Balance"
          },
          "reserved": {
            "type": "integer",
            "title": "Reserved"
          },
          "available": {
            "type": "integer",
            "title": "Available"
          },
          "currency": {
            "type": "string",
            "const": "VND",
            "title": "Currency",
            "default": "VND"
