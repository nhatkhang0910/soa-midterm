  "components": {
    "schemas": {
      "ConfirmPayment": {
        "properties": {
          "otp": {
            "type": "string",
            "maxLength": 6,
            "minLength": 6,
            "pattern": "^[0-9]{6}$",
            "title": "Otp"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "otp"
        ],
        "title": "ConfirmPayment"
      },
      "CreatePayment": {
        "properties": {
          "invoiceId": {
            "type": "string",
            "format": "uuid",
            "title": "Invoiceid"
          },
          "acceptedTerms": {
            "type": "boolean",
            "title": "Acceptedterms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "invoiceId",
          "acceptedTerms"
        ],
        "title": "CreatePayment"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "requestId": {
            "type": "string",
            "title": "Requestid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "title": "ErrorResponse"
      },
      "HistoryResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PaymentResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "pageSize": {
            "type": "integer",
            "title": "Pagesize"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "title": "HistoryResponse"
      },
      "PayerSnapshot": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "fullName": {
            "type": "string",
            "title": "Fullname"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "fullName",
          "phone",
          "email"
        ],
        "title": "PayerSnapshot"
      },
      "PaymentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING_OTP",
              "PROCESSING",
              "SUCCEEDED",
              "FAILED",
              "EXPIRED"
            ],
            "title": "Status"
          },
          "amount": {
            "type": "integer",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "const": "VND",
            "title": "Currency"
          },
          "otpExpiresAt": {
            "type": "string",
            "format": "date-time",
            "title": "Otpexpiresat"
          },
          "payer": {
            "$ref": "#/components/schemas/PayerSnapshot"
          },
          "student": {
            "$ref": "#/components/schemas/StudentSnapshot"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "failureCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failurecode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "status",
          "amount",
          "currency",
          "otpExpiresAt",
          "payer",
          "student",
          "createdAt",
          "failureCode"
        ],
        "title": "PaymentResponse"
      },
      "StudentSnapshot": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "mssv": {
            "type": "string",
            "title": "Mssv"
          },
          "fullName": {
            "type": "string",
            "title": "Fullname"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "mssv",
          "fullName"
        ],
        "title": "StudentSnapshot"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
